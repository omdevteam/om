{
    "lsp": {
        "basedpyright": {
            "settings": {
                "python": {
                    "analysis": {
                        "typeCheckingMode": "standard"
                    }
                }
            }
        },
        "ruff": {
            "initialization_options": {
                "settings": {
                    "lineLength": 88,
                    "lint": {
                        "extendSelect": ["I"]
                    }
                }
            }
        }
    },
    "languages": {
        "Python": {
            "language_servers": ["ruff", "ty", "basedpyright"],
            "format_on_save": "on",
            "code_actions_on_format": {
                "source.organizeImports.ruff": true,
                "source.fixAll.ruff": false
            }
        }
    }
}
